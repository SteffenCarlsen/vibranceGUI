<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>vibrance.GUI</RootNamespace>
    <AssemblyName>vibrance.GUI</AssemblyName>
    <ApplicationIcon>setting.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>3.0.0.0</Version>
    <AssemblyVersion>3.0.0.0</AssemblyVersion>
    <FileVersion>3.0.0.0</FileVersion>
    <Title>vibranceGUI</Title>
    <Company>vibranceGUI contributors</Company>
    <Product>vibrance.GUI</Product>
    <RepositoryUrl>https://github.com/SteffenCarlsen/vibranceGUI</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Copyright>Copyright © 2015, original contributors; fork changes 2026</Copyright>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="vibrance.GUI.Checks" />
  </ItemGroup>
</Project>
